<?xml version="1.0"?>
<robot name="mobile_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =============================================
       MOBILE ROBOT - ROS 2 Jazzy | Ubuntu 24.04
       Base: 2ft x 2ft (0.610m x 0.610m)
       Height: 1.5ft (0.457m) body
       Kiosk-style with touchpad stand + LiDAR top
       ============================================= -->

  <!-- Include materials and macros -->
  <xacro:include filename="$(find mobile_robot)/urdf/materials.xacro" />
  <xacro:include filename="$(find mobile_robot)/urdf/macros.xacro" />

  <!-- ======= ROBOT PROPERTIES ======= -->
  <!-- Base dimensions (2ft x 2ft x ~0.1m platform) -->
  <xacro:property name="base_length"  value="0.610" />  <!-- 2 ft -->
  <xacro:property name="base_width"   value="0.610" />  <!-- 2 ft -->
  <xacro:property name="base_height"  value="0.08"  />  <!-- platform thickness -->

  <!-- Main body (kiosk cabinet) -->
  <xacro:property name="body_length"  value="0.500" />
  <xacro:property name="body_width"   value="0.400" />
  <xacro:property name="body_height"  value="0.457" />  <!-- 1.5 ft -->

  <!-- Touchpad angled top section -->
  <xacro:property name="top_length"   value="0.500" />
  <xacro:property name="top_width"    value="0.400" />
  <xacro:property name="top_height"   value="0.15"  />

  <!-- LiDAR mount on flat top -->
  <xacro:property name="lidar_radius" value="0.04"  />
  <xacro:property name="lidar_height" value="0.07"  />

  <!-- Touchpad screen -->
  <xacro:property name="screen_length" value="0.28" />
  <xacro:property name="screen_width"  value="0.02" />
  <xacro:property name="screen_height" value="0.18" />

  <!-- Wheel properties -->
  <xacro:property name="wheel_radius"  value="0.075" />
  <xacro:property name="wheel_width"   value="0.05"  />
  <xacro:property name="wheel_x_off"   value="0.22"  />
  <xacro:property name="wheel_y_off"   value="0.33"  />

  <!-- Mass properties (kg) -->
  <xacro:property name="base_mass"    value="8.0"  />
  <xacro:property name="body_mass"    value="12.0" />
  <xacro:property name="top_mass"     value="3.0"  />
  <xacro:property name="wheel_mass"   value="0.8"  />
  <xacro:property name="lidar_mass"   value="0.2"  />
  <xacro:property name="screen_mass"  value="0.5"  />

  <!-- ======= INERTIA MACROS ======= -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12)*(w*w + h*h)}"
        ixy="0" ixz="0"
        iyy="${(m/12)*(l*l + h*h)}"
        iyz="0"
        izz="${(m/12)*(l*l + w*w)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12)*(3*r*r + h*h)}"
        ixy="0" ixz="0"
        iyy="${(m/12)*(3*r*r + h*h)}"
        iyz="0"
        izz="${(m/2)*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ======= WHEEL MACRO ======= -->
  <xacro:macro name="wheel" params="name x_off y_off reflect">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel"/>
      <origin xyz="${x_off} ${reflect * y_off} ${wheel_radius - base_height/2}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.01" friction="0.5"/>
      <limit effort="10.0" velocity="5.0"/>
    </joint>

    <!-- Wheel transmission for ros2_control -->
    <transmission name="${name}_wheel_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}_wheel_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <!-- ========================================
       LINKS
       ======================================== -->

  <!--  BASE FOOTPRINT (ground projection) --  -->
  <link name="base_footprint">
    <visual>
      <geometry><box size="0.001 0.001 0.001"/></geometry>
    </visual>
  </link>

  <!--  BASE LINK (drive platform) --  -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="light_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}"/>
  </link>

  <!--  BODY LINK (main kiosk cabinet) --  -->
  <link name="body_link">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="light_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}" l="${body_length}" w="${body_width}" h="${body_height}"/>
  </link>

  <!--  ANGLED TOP SECTION (touchpad housing, tilted back ~15 deg) --  -->
  <link name="top_section_link">
    <visual>
      <origin xyz="0 0 ${top_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}"/>
      </geometry>
      <material name="light_wood"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${top_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${top_length} ${top_width} ${top_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${top_mass}" l="${top_length}" w="${top_width}" h="${top_height}"/>
  </link>

  <!--  TOUCHPAD / SCREEN --  -->
  <link name="touchpad_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${screen_length} ${screen_width} ${screen_height}"/>
      </geometry>
      <material name="screen_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${screen_length} ${screen_width} ${screen_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${screen_mass}" l="${screen_length}" w="${screen_width}" h="${screen_height}"/>
  </link>

  <!--  LIDAR MOUNT PLATE --  -->
  <link name="lidar_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius + 0.02}" length="0.02"/>
      </geometry>
      <material name="metal_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius + 0.02}" length="0.02"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.1" r="${lidar_radius + 0.02}" h="0.02"/>
  </link>

  <!--  LIDAR SENSOR LINK --  -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <!--  LASER SCAN FRAME (sensor origin, z-up) --  -->
  <link name="laser_frame"/>

  <!--  IMU LINK --  -->
  <link name="imu_link"/>

  <!--  CAMERA LINK (optional front-facing) --  -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.12 0.03"/>
      </geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.12 0.03"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="0.1" l="0.04" w="0.12" h="0.03"/>
  </link>
  <link name="camera_optical_frame"/>

  <!-- ========================================
       JOINTS
       ======================================== -->

  <!-- base_footprint → base_link -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link → body_link (cabinet sits on top of platform) -->
  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="body_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- body_link → top_section_link (angled kiosk top, slight back tilt) -->
  <joint name="top_section_joint" type="fixed">
    <parent link="body_link"/>
    <child  link="top_section_link"/>
    <origin xyz="0 0 ${body_height}" rpy="0 -0.26 0"/>
  </joint>

  <!-- top_section_link → touchpad_link (front face of angled top) -->
  <joint name="touchpad_joint" type="fixed">
    <parent link="top_section_link"/>
    <child  link="touchpad_link"/>
    <origin xyz="0 ${-top_width/2 - screen_width/2} ${top_height * 0.55}" rpy="0 0.26 0"/>
  </joint>

  <!-- top_section_link → lidar_mount_link -->
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="top_section_link"/>
    <child  link="lidar_mount_link"/>
    <origin xyz="0 0 ${top_height + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- lidar_mount_link → lidar_link -->
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${lidar_height/2 + 0.01}" rpy="0 0 0"/>
  </joint>

  <!-- lidar_link → laser_frame (the actual scan plane) -->
  <joint name="laser_frame_joint" type="fixed">
    <parent link="lidar_link"/>
    <child  link="laser_frame"/>
    <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- base_link → imu_link -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- body_link → camera_link (front-mounted at mid-body height) -->
  <joint name="camera_joint" type="fixed">
    <parent link="body_link"/>
    <child  link="camera_link"/>
    <origin xyz="${body_length/2 + 0.02} 0 ${body_height * 0.55}" rpy="0 0 0"/>
  </joint>

  <!-- camera_link → camera_optical_frame (ROS optical convention) -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ======= WHEELS (4-wheel differential) ======= -->
  <!-- front-left, front-right, rear-left, rear-right -->
  <xacro:wheel name="front_left"  x_off="${wheel_x_off}"  y_off="${wheel_y_off}"  reflect="1"/>
  <xacro:wheel name="front_right" x_off="${wheel_x_off}"  y_off="${wheel_y_off}"  reflect="-1"/>
  <xacro:wheel name="rear_left"   x_off="${-wheel_x_off}" y_off="${wheel_y_off}"  reflect="1"/>
  <xacro:wheel name="rear_right"  x_off="${-wheel_x_off}" y_off="${wheel_y_off}"  reflect="-1"/>

  <!-- ========================================
       GAZEBO / ros2_control PLUGINS
       ======================================== -->
  <xacro:include filename="$(find mobile_robot)/urdf/gazebo.xacro" />

</robot>
