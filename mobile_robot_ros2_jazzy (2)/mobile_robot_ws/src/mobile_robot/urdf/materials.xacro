<?xml version="1.0"?>
<robot name="mobile_robot_materials" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== MATERIALS ===== -->

  <material name="light_wood">
    <color rgba="0.87 0.72 0.48 1.0"/>
  </material>

  <material name="dark_rubber">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="metal_grey">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <material name="lidar_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="screen_dark">
    <color rgba="0.05 0.08 0.15 0.95"/>
  </material>

  <material name="camera_blue">
    <color rgba="0.10 0.20 0.60 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

</robot>
