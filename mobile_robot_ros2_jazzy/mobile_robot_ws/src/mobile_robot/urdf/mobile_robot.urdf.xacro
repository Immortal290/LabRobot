<?xml version="1.0"?>
<!--
  ╔══════════════════════════════════════════════════════════════════════════╗
  ║  mobile_robot.urdf.xacro  —  AURA Autonomous Rover                     ║
  ║  ROS 2 Jazzy | Ubuntu 24.04 | Raspberry Pi 5                           ║
  ║                                                                          ║
  ║  Physical Dimensions:                                                    ║
  ║    Base   : 609.6 mm × 609.6 mm × 12 mm  (2 ft × 2 ft × ~0.5 in)      ║
  ║    Drive  : 4-wheel differential (2 BTS7960, each driving one side)     ║
  ║    Lidar  : YDLIDAR X4 → 150 mm above base_link origin                 ║
  ║    Camera : USB Camera  → 180 mm above base_link origin (front)         ║
  ║    IMU    : MPU9050     → centre of chassis                             ║
  ║                                                                          ║
  ║  TF Tree:                                                                ║
  ║    map → odom → base_footprint → base_link → lidar_link                ║
  ║                                            → camera_link               ║
  ║                                            → imu_link                  ║
  ║                                            → left_wheel_link           ║
  ║                                            → right_wheel_link          ║
  ║                                                                          ║
  ║  NOTE: left_wheel_link / right_wheel_link represent the LEFT SIDE and   ║
  ║        RIGHT SIDE drive groups (each drives 2 motors in parallel).      ║
  ║        The encoder used is the FRONT motor of each side.                ║
  ╚══════════════════════════════════════════════════════════════════════════╝
-->
<robot name="aura_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════════════════
       PARAMETERS
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Base plate (plywood/aluminium) -->
  <xacro:property name="base_length"    value="0.6096"/>   <!-- 2 ft = 609.6 mm -->
  <xacro:property name="base_width"     value="0.6096"/>   <!-- 2 ft = 609.6 mm -->
  <xacro:property name="base_thickness" value="0.012"/>    <!-- 12 mm            -->

  <!-- Wheel geometry — Rhino 100RPM 25Kgcm 12V Encoder Motor -->
  <!-- Parameterised: change wheel_diameter to tune odometry    -->
  <xacro:property name="wheel_diameter"   value="0.130"/>   <!-- 130 mm typical, ADJUST for your wheels -->
  <xacro:property name="wheel_radius"     value="${wheel_diameter / 2.0}"/>
  <xacro:property name="wheel_width"      value="0.050"/>   <!-- 50 mm tyre width -->

  <!--
    Wheel separation = distance between left and right wheel centrelines.
    Robot width = 609.6 mm.  Wheels protrude ~25 mm each side from the frame.
    wheel_separation = base_width + 2 * (25 mm protrusion beyond frame edge - half wheel_width)
    Conservative estimate: separation = base_width + 0.05  ≈ 0.660 m
    ADJUST this if you measure the physical centre-to-centre distance.
  -->
  <xacro:property name="wheel_separation" value="${base_width + 0.050}"/>  <!-- ~0.660 m -->

  <!-- Front-rear offset: wheels sit near the corners of the 2ft × 2ft base -->
  <xacro:property name="wheel_x_offset"  value="${base_length / 2.0 - 0.075}"/>  <!-- ~0.23 m from centre -->

  <!-- Sensor heights above base_link origin (= centre of the base plate) -->
  <xacro:property name="lidar_height_above_base"  value="0.150"/>   <!-- 150 mm per spec  -->
  <xacro:property name="camera_height_above_base" value="0.180"/>   <!-- 180 mm per spec  -->

  <!-- Lidar physical geometry (YDLIDAR X4) -->
  <xacro:property name="lidar_radius" value="0.038"/>   <!-- 76 mm diameter body -->
  <xacro:property name="lidar_body_h" value="0.032"/>   <!-- 32 mm tall body     -->

  <!-- Camera physical geometry (generic USB webcam) -->
  <xacro:property name="cam_length" value="0.030"/>
  <xacro:property name="cam_width"  value="0.090"/>
  <xacro:property name="cam_height" value="0.030"/>

  <!-- Mass estimates (kg) -->
  <xacro:property name="base_mass"   value="4.0"/>   <!-- plywood/alu plate + electronics  -->
  <xacro:property name="wheel_mass"  value="0.6"/>   <!-- Rhino motor + wheel assembly      -->
  <xacro:property name="lidar_mass"  value="0.2"/>   <!-- YDLIDAR X4                        -->
  <xacro:property name="camera_mass" value="0.08"/>  <!-- USB webcam                        -->
  <xacro:property name="imu_mass"    value="0.01"/>  <!-- MPU9050 breakout                  -->

  <!-- ═══════════════════════════════════════════════════════════════════════
       INERTIA MACROS
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Solid box inertia: m=mass, l=X-length, w=Y-width, h=Z-height -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0) * (w*w + h*h)}"  ixy="0.0" ixz="0.0"
        iyy="${(m/12.0) * (l*l + h*h)}"  iyz="0.0"
        izz="${(m/12.0) * (l*l + w*w)}"/>
    </inertial>
  </xacro:macro>

  <!-- Solid cylinder inertia: axis along Z, m=mass, r=radius, h=height -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${(m/12.0) * (3.0*r*r + h*h)}"  ixy="0.0" ixz="0.0"
        iyy="${(m/12.0) * (3.0*r*r + h*h)}"  iyz="0.0"
        izz="${(m/2.0)  * r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- Tiny dummy inertia for massless / geometry-free links -->
  <xacro:macro name="dummy_inertia">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </xacro:macro>

  <!-- ═══════════════════════════════════════════════════════════════════════
       WHEEL MACRO
       Creates a wheel link + joint.  Wheels are cylinders rotated so that
       the wheel axis aligns with the Y-axis (standard ROS convention).

       Parameters:
         name    : link name prefix   (e.g. "left_front")
         x_off   : X position from base_link centre (+fwd / -rear)
         y_sign  : +1 = left side, -1 = right side
         is_encoder : if 1, this wheel contributes to odometry (informational)
       ═══════════════════════════════════════════════════════════════════════ -->
  <xacro:macro name="wheel" params="name x_off y_sign">
    <link name="${name}_wheel_link">
      <visual>
        <!-- Cylinder visual: rotate 90° about X so it faces Y-axis -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <!--
      base_link origin = centre of the base plate in XY, and at the base plate
      mid-thickness in Z.  The base_footprint_joint raises base_link by
      (wheel_radius + base_thickness/2) so that:
        — the bottom of the wheels sits at Z=0 (ground plane)
        — the bottom of the base plate also sits at Z=0 (approximately)

      Each wheel joint is offset from base_link:
        X : ±wheel_x_offset (front / rear)
        Y : ±(wheel_separation / 2)   (left / right)
        Z : -(base_thickness/2) - wheel_radius   (below base plate centre)
            But since base_link is already raised in the footprint joint,
            we just need the wheel to be at z = -wheel_radius relative to
            the centre of the base plate.  Because:
              base_link Z = wheel_radius + base_thickness/2
              wheel centre relative to ground = wheel_radius
              => wheel joint Z relative to base_link = -base_thickness/2 - ... 
            Simplified: 0 (wheel centres share the same height as the axle
            which is at wheel_radius above the ground, same as base_link's
            bottom surface).  Wheels hang below the base, so:
              Z = -(base_thickness/2 + 0)  ...actually we want wheels at
            ground + wheel_radius, base_link is at ground + wheel_radius + base_thickness/2
            => wheel joint Z relative to base_link = -(base_thickness/2)  ≈ -0.006 m
    -->
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}_wheel_link"/>
      <origin xyz="${x_off}
                   ${y_sign * (wheel_separation / 2.0)}
                   ${-(base_thickness / 2.0)}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.5"/>
      <limit effort="15.0" velocity="6.0"/>
    </joint>
  </xacro:macro>

  <!-- ═══════════════════════════════════════════════════════════════════════
       LINKS
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ── base_footprint ──────────────────────────────────────────────────── -->
  <!-- Ground projection frame; no geometry. Origin at ground level under robot -->
  <link name="base_footprint">
    <xacro:dummy_inertia/>
  </link>

  <!-- ── base_link ──────────────────────────────────────────────────────── -->
  <!-- Physical chassis plate.  Origin at the CENTRE of the plate in XYZ.    -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_thickness}"/>
      </geometry>
      <material name="plywood">
        <color rgba="0.76 0.60 0.42 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_thickness}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       l="${base_length}"
                       w="${base_width}"
                       h="${base_thickness}"/>
  </link>

  <!-- ── lidar_link ─────────────────────────────────────────────────────── -->
  <!-- YDLIDAR X4.  Mounted on top-centre of robot at 150 mm above base_link  -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_body_h}"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_body_h}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}"
                             r="${lidar_radius}"
                             h="${lidar_body_h}"/>
  </link>

  <!-- ── camera_link ────────────────────────────────────────────────────── -->
  <!-- USB camera, front-centre of robot at 180 mm above base_link           -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${cam_length} ${cam_width} ${cam_height}"/>
      </geometry>
      <material name="camera_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${cam_length} ${cam_width} ${cam_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${camera_mass}"
                       l="${cam_length}" w="${cam_width}" h="${cam_height}"/>
  </link>

  <!-- Camera optical frame — ROS convention: Z=forward, X=right, Y=down -->
  <link name="camera_optical_frame">
    <xacro:dummy_inertia/>
  </link>

  <!-- ── imu_link ────────────────────────────────────────────────────────── -->
  <!-- MPU9050 IMU, mounted at centre of chassis -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.024 0.002"/>
      </geometry>
      <material name="pcb_green">
        <color rgba="0.0 0.5 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.024 0.002"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${imu_mass}" l="0.024" w="0.024" h="0.002"/>
  </link>

  <!-- ── left_wheel_link (virtual aggregate — left side drive group) ────── -->
  <!-- Physical: front_left_wheel_link and rear_left_wheel_link exist.       -->
  <!-- The "left_wheel_link" in the TF spec is the canonical left-side frame -->
  <!-- placed at the LEFT front wheel position (the encoder wheel).          -->
  <link name="left_wheel_link">
    <xacro:dummy_inertia/>
  </link>

  <!-- ── right_wheel_link (virtual aggregate — right side drive group) ───── -->
  <link name="right_wheel_link">
    <xacro:dummy_inertia/>
  </link>

  <!-- ═══════════════════════════════════════════════════════════════════════
       JOINTS
       ═══════════════════════════════════════════════════════════════════════ -->

  <!--
    base_footprint → base_link
    base_link origin is at the centre of the plate.
    We raise base_link by:  wheel_radius + base_thickness/2
    This puts:
      • bottom of wheels at Z = 0 (ground)
      • bottom of plate  at Z = wheel_radius (riding above axle height)
    For a flat robot this is the standard approach; the plate is above the axles.
  -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + base_thickness / 2.0}" rpy="0 0 0"/>
  </joint>

  <!--
    base_link → lidar_link
    Lidar is on a standoff on TOP of the base plate.
    base_link origin = plate centre.
    Top of plate = +base_thickness/2 above base_link origin.
    Lidar mounts at 150 mm above base_link, so offset = 0.150 m.
    (The cylinder origin is at the lidar body centre, so subtract half lidar height.)
  -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${lidar_height_above_base}" rpy="0 0 0"/>
  </joint>

  <!--
    base_link → camera_link
    Camera is mounted at the front-centre of the robot.
    X = base_length/2 (front edge)
    Z = 180 mm above base_link
  -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_length / 2.0 - cam_length / 2.0}
                 0
                 ${camera_height_above_base}"
            rpy="0 0 0"/>
  </joint>

  <!-- Camera optical joint: rotate from ROS mechanical frame to optical frame -->
  <!-- Mechanical: X=fwd, Y=left, Z=up  →  Optical: Z=fwd, X=right, Y=down  -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- base_link → imu_link (centre of chassis, flat on plate top) -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 ${base_thickness / 2.0 + 0.001}" rpy="0 0 0"/>
  </joint>

  <!-- Canonical left_wheel_link: fixed at left-front wheel position -->
  <joint name="left_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="${wheel_x_offset}
                 ${wheel_separation / 2.0}
                 ${-(base_thickness / 2.0)}"
            rpy="0 0 0"/>
  </joint>

  <!-- Canonical right_wheel_link: fixed at right-front wheel position -->
  <joint name="right_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="${wheel_x_offset}
                 ${-(wheel_separation / 2.0)}
                 ${-(base_thickness / 2.0)}"
            rpy="0 0 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════════
       4 PHYSICAL WHEELS (continuous joints for simulation / visualisation)
       Each side pair driven in parallel by one BTS7960.
       LEFT side : front_left  + rear_left   (LEFT  BTS7960)
       RIGHT side: front_right + rear_right  (RIGHT BTS7960)
       Encoder used: front_left (left), front_right (right)
       ═══════════════════════════════════════════════════════════════════════ -->
  <xacro:wheel name="front_left"  x_off=" ${wheel_x_offset}" y_sign=" 1"/>
  <xacro:wheel name="rear_left"   x_off="-${wheel_x_offset}" y_sign=" 1"/>
  <xacro:wheel name="front_right" x_off=" ${wheel_x_offset}" y_sign="-1"/>
  <xacro:wheel name="rear_right"  x_off="-${wheel_x_offset}" y_sign="-1"/>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Gazebo / ros2_control plugins (simulation only — ignored on real robot)
       ═══════════════════════════════════════════════════════════════════════ -->
  <xacro:include filename="$(find mobile_robot)/urdf/gazebo.xacro"/>

</robot>