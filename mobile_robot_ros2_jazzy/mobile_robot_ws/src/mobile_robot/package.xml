<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_robot</name>
  <version>2.0.0</version>
  <description>
    AURA Autonomous Rover — 2ft×2ft plywood base, 4-wheel differential drive
    with Rhino 100RPM 25Kgcm 12V encoder motors, YDLIDAR X4, MPU9050 IMU,
    USB camera. Encoder odometry + EKF fusion, SLAM Toolbox, Nav2.
    ROS 2 Jazzy | Ubuntu 24.04 | Raspberry Pi 5 (8GB).
  </description>

  <maintainer email="your@email.com">AURA Project</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Core ROS 2 -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>

  <!-- Robot description -->
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>xacro</depend>

  <!-- Sensor messages -->
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- TF -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Localization (EKF fusion) -->
  <depend>robot_localization</depend>

  <!-- IMU processing -->
  <depend>imu_filter_madgwick</depend>

  <!-- SLAM -->
  <depend>slam_toolbox</depend>

  <!-- Navigation -->
  <depend>nav2_bringup</depend>
  <depend>nav2_common</depend>
  <depend>nav2_msgs</depend>

  <!-- YDLIDAR X4 driver -->
  <depend>ydlidar_ros2_driver</depend>

  <!-- USB camera -->
  <depend>usb_cam</depend>

  <!-- Visualization -->
  <depend>rviz2</depend>
  <depend>rviz_default_plugins</depend>
  <depend>rviz_common</depend>

  <!-- Teleop (keyboard control during mapping) -->
  <depend>teleop_twist_keyboard</depend>

  <!-- Simulation (optional, for testing) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
