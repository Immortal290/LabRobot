+          generatedUrl = `${res.url}/quick-request`;
+        } else if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
+          const ipRes = await configApi.getNetworkIp();
+          if (ipRes.ip) {
+            generatedUrl = `${window.location.protocol}//${ipRes.ip}${window.location.port ? `:${window.location.port}` : ''}/quick-request`;
+          }
+        }
+      } catch (e) {}
+      if (generatedUrl) {
+        setPortalUrl(generatedUrl);
+        const dataUrl = await QRCode.toDataURL(generatedUrl, { width: 180, margin: 2, color: { dark: '#ffffff', light: '#0a1122' } });
+        setQrCodeUrl(dataUrl);
+      }
+    };
+    setupPortal();
+
+    const connectWs = () => {
+      const ws = new WebSocket(`${window.location.protocol === 'https:' ? 'wss:' : 'ws:'}//${window.location.host}/ws/ui`);
+      wsRef.current = ws;
+      ws.onmessage = (e) => {
+        const data = JSON.parse(e.data);
+        if (data.type === 'telemetry') setTelemetry(data);
+      };
+      ws.onclose = () => setTimeout(connectWs, 5000);
+    };
+    connectWs();
+    return () => wsRef.current?.close();
+  }, []);
